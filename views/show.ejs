<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="main-wrapper">
  <%- include('partials/topbar') %>

  <main class="content-body">
    <div class="detail-container">
      <!-- Detail Header Navigation & Actions -->
      <div class="page-header" style="margin-bottom: 1.5rem;">
        <div>
          <a href="/memories" style="color: var(--text-muted); text-decoration: none; font-size: 0.85rem;">← Back to Memories</a>
          <h1 class="page-title" style="margin-top: 0.5rem;">
            <%= memory.title %>
            <span class="type-badge badge-<%= memory.type %>"><%= memory.type %></span>
          </h1>
          <div style="font-size: 0.85rem; color: var(--text-dim); margin-top: 0.5rem; display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
            <% if (memory.category) { %>
              <span>📁 <strong>Category:</strong> <%= memory.category %> <% if(memory.sub_category) { %> › <%= memory.sub_category %><% } %></span>
            <% } %>
            <span>📅 Created <%= new Date(memory.created_at).toLocaleDateString() %></span>
          </div>
        </div>

        <div class="detail-actions">
          <a href="/memories/<%= memory.id %>/edit" class="btn btn-secondary">✏️ Edit</a>
          <form action="/memories/<%= memory.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this memory?');" style="display: inline;">
            <button type="submit" class="btn btn-danger">🗑️ Delete</button>
          </form>
        </div>
      </div>

      <!-- Tags List -->
      <% if (memory.tags) { %>
        <div class="tags-list" style="margin-bottom: 1.5rem;">
          <% memory.tags.split(',').forEach(tag => { %>
            <a href="/memories?tag=<%= encodeURIComponent(tag.trim()) %>" class="tag-item" style="font-size: 0.85rem; padding: 0.25rem 0.6rem; text-decoration: none;">
              #<%= tag.trim() %>
            </a>
          <% }) %>
        </div>
      <% } %>

      <!-- ===================================================================
           TYPE-SPECIFIC RENDERING ENGINE
           =================================================================== -->

      <% if (memory.type === 'Code') { %>
        <!-- VS Code Inspired Dark Editor UI -->
        <div class="vscode-editor-container">
          <div class="vscode-header">
            <div class="vscode-tabs">
              <div class="vscode-tab">
                <span>📄 <%= memory.title.toLowerCase().replace(/\s+/g, '_') %>.<%= memory.code_language === 'javascript' ? 'js' : memory.code_language === 'python' ? 'py' : memory.code_language === 'html' ? 'html' : 'txt' %></span>
              </div>
              <span style="font-size: 0.75rem; color: var(--accent-cyan); background: rgba(6,182,212,0.15); padding: 0.15rem 0.4rem; border-radius: 4px; font-weight: 600;">
                <%= (memory.code_language || 'javascript').toUpperCase() %>
              </span>
            </div>
            <div class="vscode-actions">
              <button id="copy-code-btn" class="btn-copy">
                📋 Copy Code
              </button>
            </div>
          </div>
          <pre class="vscode-code-body"><code id="code-content-block" class="language-<%= memory.code_language || 'javascript' %>"><%= memory.content %></code></pre>
        </div>

      <% } else if (memory.type === 'Note') { %>
        <!-- Note Document Style UI -->
        <div class="note-doc-container">
          <div class="note-doc-body"><%= memory.content %></div>
        </div>

      <% } else if (memory.type === 'Task') { %>
        <!-- Task Productivity Dashboard Style UI -->
        <div class="task-container">
          <div class="task-status-row">
            <div>
              <span style="font-size: 0.9rem; color: var(--text-dim);">Task Status</span>
              <div style="font-size: 1.25rem; font-weight: 700; margin-top: 0.25rem;">
                <% if (memory.task_status === 'Completed') { %>
                  <span style="color: var(--accent-emerald);">✅ Completed</span>
                <% } else if (memory.task_status === 'In Progress') { %>
                  <span style="color: var(--accent-amber);">⏳ In Progress</span>
                <% } else { %>
                  <span style="color: var(--text-muted);">📋 Todo</span>
                <% } %>
              </div>
            </div>
            <div style="text-align: right;">
              <span style="font-size: 0.9rem; color: var(--text-dim);">Progress</span>
              <div style="font-size: 1.5rem; font-weight: 700; color: var(--accent-emerald);">
                <%= memory.task_percentage %>%
              </div>
            </div>
          </div>

          <div class="task-progress-large">
            <div class="task-progress-large-fill" style="width: <%= memory.task_percentage %>%;"></div>
          </div>

          <div style="margin-top: 1.5rem; line-height: 1.7; font-size: 1.05rem; white-space: pre-line;">
            <%= memory.content %>
          </div>
        </div>

      <% } else if (memory.type === 'Idea') { %>
        <!-- Idea Card Style UI -->
        <div class="idea-container">
          <div style="font-size: 0.85rem; font-weight: 600; color: var(--accent-amber); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem;">
            💡 Sparked Idea
          </div>
          <div style="font-size: 1.1rem; line-height: 1.8; color: #fef3c7; white-space: pre-line;">
            <%= memory.content %>
          </div>
        </div>

      <% } else if (memory.type === 'Bookmark') { %>
        <!-- Bookmark Link Preview UI -->
        <div class="bookmark-container">
          <div style="font-size: 0.85rem; font-weight: 600; color: var(--accent-blue); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem;">
            🔖 Saved Link
          </div>

          <% if (memory.url) { %>
            <div class="bookmark-link-box">
              <a href="<%= memory.url %>" target="_blank" rel="noopener noreferrer" class="bookmark-url">
                🌐 <%= memory.url %>
              </a>
              <a href="<%= memory.url %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="padding: 0.4rem 0.85rem; font-size: 0.8rem;">
                Open Link ↗
              </a>
            </div>
          <% } %>

          <div style="margin-top: 1.5rem; line-height: 1.7; color: var(--text-muted); white-space: pre-line;">
            <%= memory.content %>
          </div>
        </div>
      <% } %>
    </div>
  </main>
</div>

<%- include('partials/footer') %>
